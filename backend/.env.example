# NetEvidence AI - Backend Environment Configuration
# Configured in Vercel Project Settings -> Environment Variables

# Security Secret for JWT signing (Required in Production: 32+ char random string)
SECRET_KEY=change-this-in-production-to-a-random-32-byte-hex-string

# Database connection string
# Local development: sqlite:///./netevidence.db
# Vercel serverless default: sqlite:////tmp/netevidence.db
# External persistent database (Neon / Supabase / Postgres): postgresql://user:password@host:port/dbname
DATABASE_URL=sqlite:///./netevidence.db

# Allowed CORS Origins (comma-separated custom domains)
# Note: *.vercel.app and localhost are already permitted by default regex
ALLOWED_ORIGINS=https://a3-ps010-tc192.vercel.app

# Live Intelligence Settings
HTTP_TIMEOUT_SECONDS=4.5
RIPE_STAT_BASE_URL=https://stat.ripe.net/data
